# Copy your existing .env when moving computers. Otherwise run npm run init:local.
ADMIN_KEY=replace-with-a-random-secret-at-least-32-characters
# Base64 encoding of exactly 32 random bytes. Preserve the original value.
UPSTREAM_KEY_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Optional: an existing production deployment with a custom domain.
# Uncomment and fill these in .env only; in Workers Builds use build variables.
# Keep these commented here so the deploy button requests only the two secrets above.
# DEPLOY_WORKER_NAME=thin-proxy
# DEPLOY_ACCOUNT_ID=your-cloudflare-account-id
# DEPLOY_DATABASE_NAME=thin-proxy
# DEPLOY_DATABASE_ID=your-existing-d1-database-id
# DEPLOY_CUSTOM_DOMAIN=relay.example.com
# DEPLOY_SELF_HOSTS=relay.example.com,thin-proxy.your-subdomain.workers.dev
