{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thin-proxy",
  "account_id": "ec8ee3fdd7929dc2587e1a8052a7ae9a",
  "workers_dev": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "thin-proxy",
    "database_id": "0878e16c-7d65-43d2-94e2-e37ff2928124",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "CONFIG_CACHE_TTL_SECONDS": "30",
    "SELF_HOSTS": "thin-proxy.skpm.workers.dev"
  },
  "observability": { "enabled": false }
}
